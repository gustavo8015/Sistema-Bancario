@startuml casos_uso
left to right direction
skinparam shadowing false
skinparam defaultFontName Times New Roman
title Diagrama de casos de uso - Sistema bancario distribuido

actor "Cliente del banco" as C
actor "Pareja / cotitular" as P
actor "Auditor del banco" as A
actor "Sistema de red" as R <<sistema>>

rectangle "Sistema bancario distribuido" {
  usecase "Retirar dinero en cajero" as UC1
  usecase "Consultar saldo" as UC2
  usecase "Bloquear cuenta en todas las replicas" as UC3
  usecase "Confirmar o abortar transaccion (2PC)" as UC4
  usecase "Propagar actualizacion a las replicas" as UC5
  usecase "Detectar conflicto / sobregiro" as UC6
  usecase "Cancelar operacion por particion de red" as UC7
}

C --> UC1
C --> UC2
P --> UC1
P --> UC2
A --> UC6
R --> UC7
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC4 ..> UC5 : <<include>>
UC7 ..> UC4 : <<extend>>
UC6 ..> UC5 : <<extend>>
@enduml
